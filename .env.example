# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 git에 올라가지 않습니다.
# 키는 채팅이나 문서에 붙여넣지 마세요.

# OpenAI 이미지 생성 (선택)
OPENAI_API_KEY=
# 한 번 실행에서 쓸 수 있는 최대 금액(달러). 넘으면 생성하지 않고 멈춥니다.
DOHA_MAX_COST_USD=1.00

# Instagram API (선택, 프로페셔널 계정 전환 후)
IG_ACCESS_TOKEN=
IG_USER_ID=

# Chromium 경로를 직접 지정해야 할 때만 (보통 비워 둠)
CHROMIUM_PATH=
